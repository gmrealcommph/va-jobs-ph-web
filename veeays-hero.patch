diff --git a/public/styles.css b/public/styles.css
index bdcf61b..3b223da 100644
--- a/public/styles.css
+++ b/public/styles.css
@@ -5721,3 +5721,28 @@ body>header,body>footer{flex-shrink:0}
 .pro-board-flight{position:absolute;right:18px;top:28px;width:105px;height:auto;color:#123e30}
 .pro-free-note{max-width:760px;border-left:3px solid #f2bb52;padding-left:16px}
 @media(max-width:800px){.pro-comparison-board{grid-template-columns:1fr;gap:36px;margin-top:36px}.pro-plan-paper{padding:28px 24px}.pro-plan-plus{margin-top:0}.pro-plan-paper h3{min-height:0;font-size:32px}.pro-plan-plus h3{padding-right:54px}.pro-board-flight{width:80px;top:40px;right:12px}.pro-plan-note{right:12px;font-size:9px}}
+
+/* Original 1591 × 989 transparent PNG; crop only its empty left margin.
+   A 580px frame displays the 1160px artwork region at up to 2x density. */
+.home-hero .premium-collage.approved-hero-art,
+.home-hero .premium-collage.approved-hero-art:hover{
+  width:100%;
+  max-width:580px;
+  aspect-ratio:1160 / 989;
+  margin:0 0 0 auto;
+  overflow:hidden;
+  transform:none;
+  transition:none;
+  filter:none;
+}
+.home-hero .approved-hero-art img{
+  width:100%;
+  height:100%;
+  object-fit:cover;
+  object-position:right center;
+  animation:none;
+  transform:none;
+}
+@media(max-width:600px){
+  .home-hero .premium-collage.approved-hero-art{margin:16px auto 0}
+}
\ No newline at end of file
