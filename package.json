{
  "name": "va-jobs-ph-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:resume": "wrangler dev --config wrangler.resume-local.jsonc --local --port 8787",
    "test:resume": "node --test test/resume-studio.test.js test/resume-ux.test.js test/resume-design-export.test.js test/resume-release.test.js",
    "build": "node scripts/resume-release-review-gate.mjs",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "verify:production": "npm run build && node scripts/verify-production-parity.mjs",
    "build:resume-release": "node scripts/build-resume-release.mjs",
    "test:resume-release": "node --test test/resume-release-parity.test.js test/resume-release-exports.test.js",
    "predeploy": "node scripts/resume-release-review-gate.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "acorn": "8.15.0",
    "wrangler": "4.144.0",
    "esbuild": "0.28.1"
  },
  "packageManager": "pnpm@11.25.0"
}
