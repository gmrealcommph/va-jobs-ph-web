{
  "name": "va-jobs-ph-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:resume": "wrangler dev --config wrangler.resume-local.jsonc --local --port 8787",
    "test:resume": "node --test test/resume-studio.test.js test/resume-ux.test.js test/resume-design-export.test.js test/resume-release.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "verify:production": "npm run build && node scripts/verify-production-parity.mjs",
    "test:auth": "node --test test/signup-origin.test.js test/signup-captcha-integration.test.js test/auth-session-recovery.test.js test/reset-password-authorization.test.js test/onboarding.test.js test/niche-finder.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "acorn": "8.15.0",
    "wrangler": "4.144.0"
  },
  "packageManager": "pnpm@11.25.0"
}
